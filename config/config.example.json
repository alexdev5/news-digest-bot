{
  "schema_version": 4,
  "defaults": {
    "timezone": "Europe/Kyiv",
    "misfire_grace_seconds": 10800,
    "ai": { "model": "gpt-6.1-terra", "reasoning_effort": "medium", "max_output_tokens": 8192 },
    "publication": { "max_chars_per_message": 3500, "link_preview": false }
  },
  "target_channels": [
    {
      "id": "dnipro_news",
      "enabled": true,
      "name": "Новини Дніпра",
      "description": "Події Дніпра та області",
      "telegram": "@example_my_dnipro_digest",
      "schedule": { "times": ["08:00", "21:00"], "timezone": "Europe/Kyiv" },
      "scan_start_at": "2026-11-12T00:00:00+02:00",
      "source_channels": [
        { "id": "example_city", "enabled": true, "ref": "@example_city_news", "name": "Міські новини" },
        { "id": "example_region", "enabled": true, "ref": "https://t.me/example_region_news", "name": null }
      ],
      "source_sites": [
        {
          "id": "example_site",
          "enabled": true,
          "name": "Example.ua",
          "url": "https://example.ua/news",
          "rss": "https://example.ua/rss",
          "selectors": null
        }
      ],
      "ai": { "prompt_file": "prompts/news-ua.md" },
      "filters": { "exclude_patterns": ["реклама", "розіграш"] },
      "format": { "header": "{name} · {date} {time}" },
      "daily_budget_usd": 1.0
    },
    {
      "id": "crypto",
      "enabled": false,
      "name": "Крипта",
      "description": "Новини крипторинку без торгових сигналів",
      "telegram": "@example_my_crypto_digest",
      "schedule": { "every_seconds": 21600, "anchor_at": "2026-11-12T00:00:00+02:00" },
      "scan_start_at": "2026-11-12T00:00:00+02:00",
      "source_channels": [
        { "id": "example_crypto", "enabled": true, "ref": "@example_crypto_news", "name": null }
      ],
      "source_sites": [
        {
          "id": "example_crypto_site",
          "enabled": true,
          "name": "Crypto Example",
          "url": "https://crypto.example.com/news",
          "rss": null,
          "selectors": { "item": "article h2 a", "title": "h1", "date": "time[datetime]", "content": "article" }
        }
      ],
      "ai": { "prompt": "Пиши стисло, без порад купувати чи продавати." },
      "filters": { "exclude_patterns": [] },
      "format": { "header": "{name} · {period}" },
      "daily_budget_usd": null
    }
  ]
}

# Скопіюйте в .env і змініть пароль. .env не комітиться.
POSTGRES_DB=news_digest
POSTGRES_USER=news_digest
POSTGRES_PASSWORD=news_digest
# Порт PostgreSQL на хості (5432 зайнятий crypto-bot).
POSTGRES_HOST_PORT=5433

# Telegram API з https://my.telegram.org (API development tools). Не комітити.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# OpenAI API key (platform.openai.com → API keys). Використовується з етапу 4. Не комітити.
OPENAI_API_KEY=

# Для запуску з хоста без Docker (uv run …):
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
NEWSDIGEST_STATE_DIR=./state
NEWSDIGEST_CACHE_DIR=./cache
NEWSDIGEST_SESSION_DIR=./session

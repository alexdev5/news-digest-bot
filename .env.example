# Скопіюйте в .env і змініть пароль. .env не комітиться.
POSTGRES_DB=news_digest
POSTGRES_USER=news_digest
POSTGRES_PASSWORD=news_digest
# Порт PostgreSQL на хості (5432 зайнятий crypto-bot).
POSTGRES_HOST_PORT=5433

# Для запуску з хоста без Docker (uv run …):
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
